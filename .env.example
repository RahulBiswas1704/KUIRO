# ==============================================================================
# KUIRO — Autonomous AI Marketing Employee Environment Configuration
# Tech Stack: Neon Postgres + Drizzle ORM + Better Auth + Cloudflare R2 + Inngest
# ==============================================================================

# Application Base
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# 1. Neon Serverless PostgreSQL & Drizzle ORM
# Pooled connection string for serverless API routes
DATABASE_URL="postgresql://kuiro_owner:password@ep-cool-sample-123456-pooler.us-east-2.aws.neon.tech/kuiro?sslmode=require"
# Direct connection string for Drizzle migrations (non-pooled)
DIRECT_URL="postgresql://kuiro_owner:password@ep-cool-sample-123456.us-east-2.aws.neon.tech/kuiro?sslmode=require"

# 2. Better Auth (Authentication & Session Management)
BETTER_AUTH_SECRET="kuiro_super_secret_session_encryption_key_32_chars_min"
BETTER_AUTH_URL="http://localhost:3000"

# 3. Cloudflare R2 Media Storage & CDN (AWS S3-Compatible SDK)
R2_ACCOUNT_ID="your_cloudflare_account_id_hex"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="kuiro-media"
# Public CDN domain or Cloudflare r2.dev URL for Meta/YouTube webhook access
R2_PUBLIC_URL="https://pub-your-id.r2.dev"

# 4. AI & Media Generation Pipeline
# Google Gemini 2.5 Flash / Pro (Copywriting, Brand Brain & Audio Whisper)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
# Optional fallback models
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# 5. Inngest Durable Execution & 48-Hour State Machine
INNGEST_EVENT_KEY="your_inngest_event_key_or_local_dev"
INNGEST_SIGNING_KEY="your_inngest_signing_key_or_local_dev"

# 6. Meta WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN="EAAxxxxYourMetaWhatsAppCloudToken"
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_meta_waba_id"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="kuiro_wa_verify_token_secure_123"

# 7. Multi-Channel OAuth & API Publishing Keys
# Meta (Facebook Pages & Instagram Professional)
META_APP_ID=""
META_APP_SECRET=""
# LinkedIn Marketing Developer API
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# X (Twitter) Developer API v2
X_API_KEY=""
X_API_SECRET=""
# Google Cloud (YouTube Shorts API v3)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 8. Security & Encryption
ENCRYPTION_KEY="kuiro_aes_256_gcm_token_vault_key_32_bytes_hex"
